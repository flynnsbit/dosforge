# Local DOS asset folders — keep the structure + readme.txt tracked,
# but ignore the install media payload the user drops inside.
/dosassets/*/*
!/dosassets/*/readme.txt
/tdlprocessed/
/win21-*/

# Build artifacts and test outputs
/build/
__pycache__/
*.pyc
.pytest_cache/

# Local VHD / floppy images and install archives (large binary artifacts)
*.vhd
*.img
*.ima
*.7z
*.zip
testing-notes.md
